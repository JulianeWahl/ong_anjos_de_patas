# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Banco no Neon (neon.tech) → seu projeto → Connect → copie a "connection string"
# do branch "dev" (para desenvolver). O de produção fica só no Render.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Texto longo e aleatório. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

PORT=3000
NODE_ENV=development

# Dados exibidos na página "Como ajudar"
PIX_CHAVE=""
PIX_NOME=""
