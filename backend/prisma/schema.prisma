generator client{
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db{
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Animal {
  id          String   @id @default(uuid())
  nome        String
  especie     String
  idade       Int?
  descricao   String?
  fotoUrl     String?
  adotado     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}